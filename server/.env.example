PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB works out of the box. Point this at an Atlas cluster to use
# real Atlas Vector Search (also set USE_ATLAS_VECTOR_SEARCH=true below).
MONGODB_URI=mongodb://127.0.0.1:27017/ai-telemedicine-triage

# Optional: enables real OpenAI embeddings for symptom matching. Without
# this, the server falls back to a deterministic local embedding so
# symptom matching still works fully offline.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional: switch symptom matching from in-process cosine similarity to a
# real MongoDB Atlas Search vector index. Requires MONGODB_URI to point at
# an Atlas cluster with a vector index named ATLAS_VECTOR_INDEX_NAME on the
# symptomentries collection's "embedding" field.
USE_ATLAS_VECTOR_SEARCH=false
ATLAS_VECTOR_INDEX_NAME=symptom_vector_index
